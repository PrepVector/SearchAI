# ============================================================
#  SEARCH AI — configuration  (generated from your uploaded .env)
#  All keys, model names and fallback chains below came from your
#  file; variable names were mapped to this build's schema.
#  Old flags like FULL_PHD_PAPER_MODE / ANTI_GENERIC_MODE /
#  HUMANIZER_PASSES are built-in behaviors here and need no vars.
# ============================================================

# ---------- TEXT / REASONING PROVIDERS ----------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-pro-preview,gemini-3.1-flash-lite,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite

OPENAI_API_KEY=
OPENAI_FALLBACK_MODELS=gpt-5.4,gpt-5.4-mini,gpt-5.4-nano,gpt-4.1,gpt-4.1-mini,gpt-4o,gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5
ANTHROPIC_FALLBACK_MODELS=claude-opus-4-8,claude-sonnet-4-6,claude-haiku-4-5

# Any OpenAI-compatible endpoint (Groq, Together, OpenRouter, Ollama, ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_FALLBACK_MODELS=

# ---------- IMAGE GENERATION MODELS ---------------------------
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODELS=gemini-3-pro-image,gemini-2.5-flash-image
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_FALLBACK_MODELS=gpt-image-1.5,gpt-image-1,gpt-image-1-mini

# ---------- WEB RESEARCH PROVIDERS -----------------------------
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=

# ---------- ACADEMIC RESEARCH ----------------------------------
OPENALEX_EMAIL=rsengupta501@gmail.com
CROSSREF_EMAIL=rsengupta501@gmail.com

# ---------- PROVIDER ROUTING per agent role ---------------------
TEXT_PROVIDER_ORDER=anthropic,openai,gemini
RESEARCH_PROVIDER_ORDER=gemini,anthropic,openai,openai_compatible
EDITOR_PROVIDER_ORDER=anthropic,openai,gemini
VALIDATOR_PROVIDER_ORDER=gemini,anthropic,openai
IMAGE_PROVIDER_ORDER=gemini,openai,openai_compatible

# ---------- QUALITY & BEHAVIOR FLAGS -----------------------------
PREMIUM_AI_QUALITY_MODE=true
ENABLE_REFERENTIAL_IMAGES=true
ENABLE_REFERENCE_DEEP_IMAGE_SEARCH=true
MAX_VISUAL_REFERENCES=36
DEFAULT_MIN_IMAGES=5

# ---------- TIMEOUTS & SERVER ------------------------------------
LLM_TIMEOUT_SECONDS=180
SEARCH_TIMEOUT_SECONDS=30
SEARCH_AI_HOST=127.0.0.1
SEARCH_AI_PORT=8025

# --- premium prose: let writer/editor models think before writing ---
ENABLE_EXTENDED_THINKING=true
THINKING_BUDGET_TOKENS=4096
