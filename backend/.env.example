# ============================================================
#  SEARCH AI — configuration template
#  Copy this file to ".env" and fill in at least ONE text
#  provider (key + model). Everything else is optional.
#  No model names are hardcoded anywhere — set them here.
#
#  Fallback chains: each provider accepts a comma-separated
#  *_FALLBACK_MODELS list; the app tries the primary model,
#  then each fallback, then the next provider in the role order.
#  Legacy variable names (GEMINI_TEXT_MODEL, OPENAI_COMPATIBLE_*,
#  APP_PORT, MIN_IMAGES, ENABLE_WEB_IMAGES) are also accepted.
# ============================================================

# ---------- TEXT / REASONING PROVIDERS ----------------------
# Google Gemini  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# OpenAI  (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_FALLBACK_MODELS=

# Anthropic Claude  (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_FALLBACK_MODELS=

# Any OpenAI-compatible endpoint (Groq, Together, OpenRouter, Ollama, ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_FALLBACK_MODELS=

# ---------- IMAGE GENERATION MODELS (optional) ---------------
# If set, "regenerated" image mode uses a real image model; otherwise the
# built-in deterministic visual engine draws topic-specific SVG figures.
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_FALLBACK_MODELS=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_FALLBACK_MODELS=

# ---------- WEB RESEARCH PROVIDERS (any subset) ---------------
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=

# ---------- ACADEMIC RESEARCH (keyless, email = polite pool) --
OPENALEX_EMAIL=
CROSSREF_EMAIL=

# ---------- PROVIDER ROUTING per agent role -------------------
# Comma-separated fallback chains. Options:
#   gemini, openai, anthropic, openai_compatible
TEXT_PROVIDER_ORDER=anthropic,openai,gemini
RESEARCH_PROVIDER_ORDER=gemini,openai,anthropic
EDITOR_PROVIDER_ORDER=anthropic,openai,gemini
VALIDATOR_PROVIDER_ORDER=gemini,anthropic,openai
IMAGE_PROVIDER_ORDER=gemini,openai

# ---------- QUALITY & BEHAVIOR FLAGS ---------------------------
PREMIUM_AI_QUALITY_MODE=true
ENABLE_REFERENTIAL_IMAGES=true
ENABLE_REFERENCE_DEEP_IMAGE_SEARCH=true
MAX_VISUAL_REFERENCES=36
DEFAULT_MIN_IMAGES=5

# ---------- TIMEOUTS & SERVER ---------------------------------
LLM_TIMEOUT_SECONDS=180
SEARCH_TIMEOUT_SECONDS=30
SEARCH_AI_HOST=127.0.0.1
SEARCH_AI_PORT=8712

# --- premium prose: let writer/editor models think before writing ---
ENABLE_EXTENDED_THINKING=true
THINKING_BUDGET_TOKENS=4096
